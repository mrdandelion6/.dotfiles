#!/usr/bin/env bash
# welcome: print the welcome message. fastfetch if installed, otherwise the binary rain
# cat, otherwise the ascii art below

# add colors here
CUSTOM_PINK='\e[38;2;228;171;212m'
CUSTOM_GRAY='\e[38;2;196;189;210m'
NC='\e[0m'

# configure these as you like
CENTERED_WELCOME=1
WELCOME_COLOR=$CUSTOM_GRAY

# change this to a different location if you want
ascii_path="$HOME/.dotfiles/ascii_art/"
ascii_art="reaper2.txt"

center_text() {
    # print the given text centered in the terminal for whatever width
    if [[ $CENTERED_WELCOME -eq 0 ]]; then
        cat -
        return
    fi

    local term_width line plain_line padding
    term_width=$(tput cols)

    # read input line by line while preserving colors
    while IFS= read -r line; do
        # strip ansi color codes for width calculation
        plain_line=$(echo -e "$line" | sed 's/\x1b\[[0-9;]*m//g')
        padding=$(( (term_width - ${#plain_line}) / 2 ))
        printf "%${padding}s%s\n" "" "$line"
    done
}

# --- binary rain cat welcome ---
CAT_ART_FILE="${ascii_path}cat.txt"
CAT_FULL_W=109
CAT_FULL_H=39
CAT_MIN_W=50
CAT_MIN_H=35
CAT_CENTER_COL=54  # horizontal center of the art

show_cat() {
    local term_w term_h
    term_w=$(tput cols)
    term_h=$(tput lines)

    [[ $term_w -lt $CAT_MIN_W || $term_h -lt $CAT_MIN_H ]] && return

    local art_w art_h
    art_w=$(( term_w < CAT_FULL_W ? term_w : CAT_FULL_W ))
    art_h=$(( term_h - 2 < CAT_FULL_H ? term_h - 2 : CAT_FULL_H ))

    local half=$(( art_w / 2 ))
    local col_start=$(( CAT_CENTER_COL - half ))
    local col_end=$(( col_start + art_w - 1 ))
    [[ $col_start -lt 0 ]] && col_start=0 && col_end=$(( art_w - 1 ))
    [[ $col_end -ge $CAT_FULL_W ]] && col_end=$(( CAT_FULL_W - 1 )) && col_start=$(( col_end - art_w + 1 ))
    [[ $col_start -lt 0 ]] && col_start=0
    local visible_w=$(( col_end - col_start + 1 ))

    local pad=$(( (term_w - visible_w) / 2 ))
    local pad_str line
    pad_str=$(printf "%${pad}s" "")

    echo
    while IFS= read -r line; do
        echo "${pad_str}${line}"
    done < <(python3 -c "
lines = open('$CAT_ART_FILE').read().splitlines()
for l in lines[:${art_h}]:
    l = l + ' ' * (${CAT_FULL_W} - len(l))
    print(l[${col_start}:${col_end}+1])
")
    echo
}

# fastfetch that fits the terminal width (e.g. an nvim terminal whose number column eats
# a few columns). the box borders and the color dot rows are fixed width , so shrink them
# when the terminal is too narrow. full size output is unchanged in wide terminals
fastfetch_fit() {
    local cfg=~/.config/fastfetch/config.jsonc
    if [ ! -f "$cfg" ]; then
        fastfetch # no config linked yet, use fastfetch's default
        return
    fi
    local avail=$(( $(tput cols) - 41 )) # info column starts at 41 (logo + padding)
    local n=$(( (avail - 3) / 2 )) # dashes per half of a border , 30 at full size
    (( n > 30 )) && n=30; (( n < 1 )) && n=1
    local gap=$(( 5 - 2 * (30 - n) )) # middle gap of the color dot rows , 5 at full size
    (( gap < 1 )) && gap=1
    local dashes spaces tmp="${XDG_RUNTIME_DIR:-/tmp}/fastfetch-welcome.jsonc"
    dashes=$(printf '%*s' $n '' | sed 's/ /─/g')
    spaces=$(printf '%*s' $gap '')
    sed -e "s/\"──────────────────────────────\"/\"$dashes\"/" \
        -e "s/     {##/$spaces{##/g" "$cfg" > "$tmp"
    # autowrap off so anything still too wide gets cut at the edge instead of wrapping
    printf '\e[?7l'; fastfetch -c "$tmp"; printf '\e[?7h'
}

if command -v fastfetch >/dev/null 2>&1; then
    echo; echo
    fastfetch_fit
elif [ -f "$CAT_ART_FILE" ]; then
    show_cat
elif [ -f "$ascii_path$ascii_art" ]; then
    echo; echo
    echo -e "${WELCOME_COLOR}$(cat "$ascii_path$ascii_art")${NC}" | center_text
fi
echo; echo
