#!/usr/bin/env bash
# venvpath: print the bin folder (bin/ or Scripts/) of venv <name> in $envdir
# usage: venvpath <name>
#
# this holds the shared logic for actvenv. actvenv itself has to be a function in each
# shell (bash and fish), since activating a venv changes the shell it runs in, so it
# just sources the activate script from the folder this prints
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

check_env_name "$1"
path="$envdir/$1"
[ -d "$path" ] || die "environment not found: $path"
venv_bin "$path"
